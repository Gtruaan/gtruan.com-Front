        "prompt_version": 4
      }
    },
    "step:natural-square": {
      "title": "Transfer squarehood to ℕ",
      "summary": "Write a candidate rational square root of n as a reduced fraction a/b with b > 0. In its square, a² and b² are still coprime. Since n has denominator 1, b must be 1 and |a| is a natural root. A natural square witness also works as a rational witness by coercion.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "\\operatorname{IsSquare}_{\\mathbb Q}(n)\\iff\\operatorname{IsSquare}_{\\mathbb N}(n)",
      "concepts": [
        "coercion"
      ],
      "why_here": "This turns the rational criterion into the natural-number premise used for primes.",
