    "step:rational-square": {
      "title": "Square the rational witness",
      "summary": "Start with a nonnegative rational q. If its real square root is the image of a rational r, squaring gives r² = q in the rationals, because the embedding into the reals preserves multiplication and is injective. In the other direction, r² = q gives the real square root |r|, again rational.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "(\\sqrt q)^2=q",
      "concepts": [
        "rational-squares"
      ],
      "why_here": "This establishes the rational criterion by unfolding irrationality and translating the witnesses in both directions.",
