    "lean:irrational_sqrt_ratCast_iff_of_nonneg": {
      "title": "Rational square criterion",
      "summary": "For a nonnegative rational q, its real square root is rational exactly when q is a square in the rationals. A rational value for the root squares to q, and a rational square witness r gives the root |r|. For example, the rational square 9/4 gives the root 3/2.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "q\\ge 0\\implies (\\sqrt q\\notin\\mathbb Q\\iff\\neg\\operatorname{IsSquare}_{\\mathbb Q}(q))",
      "concepts": [
        "rational-squares"
      ],
      "why_here": "The witness argument summarizes the proof of this equivalence.",
      "support_edges": [
