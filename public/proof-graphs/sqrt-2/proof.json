    "fact:natural-square": {
      "title": "Natural square criterion",
      "summary": "For a natural radicand n, the previous criteria combine into a test using only natural numbers. If n = k², the root is k. If there is no such natural k, the reduced-fraction argument rules out any rational root too.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "\\sqrt n\\notin\\mathbb Q\\iff\\neg\\operatorname{IsSquare}_{\\mathbb N}(n)",
      "concepts": [
