      }
    },
    "lean:Nat.Prime.irrational_sqrt": {
      "title": "Square roots of primes",
      "summary": "A prime p is greater than 1. If it were a natural square k², then k would be a proper divisor with 1 < k < p. The natural square criterion therefore makes √p irrational.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "\\operatorname{Prime}(p)\\implies\\sqrt p\\notin\\mathbb Q",
      "concepts": [
        "primality"
      ],
      "why_here": "This is the general theorem instantiated at 2 in the final step.",
