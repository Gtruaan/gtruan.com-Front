    "lean:Irreducible.not_isSquare": {
      "title": "Irreducible elements are nonsquares",
      "summary": "A square factors into two equal factors. Irreducibility would make one of those factors a unit, and then their product would also be a unit, contrary to irreducibility. For natural numbers, primality supplies the irreducibility used here.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "\\operatorname{Irreducible}(p)\\implies\\neg\\operatorname{IsSquare}(p)",
      "concepts": [
