    },
    "fact:rational-square": {
      "title": "Nonnegative rational criterion",
      "summary": "The criterion gives two equivalent ways to supply a rational witness. You can write the real number √q as a fraction or exhibit a rational number whose square is q. For instance, 9/4 = (−3/2)² and √(9/4) = 3/2. Negating the equivalence makes a rational nonsquare exactly a nonnegative rational with an irrational square root.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "\\sqrt q\\notin\\mathbb Q\\iff\\neg\\operatorname{IsSquare}_{\\mathbb Q}(q)",
      "concepts": [
        "rational-squares"
      ],
      "why_here": "This is the criterion carried over to natural inputs in the next step.",
      "support_edges": [
