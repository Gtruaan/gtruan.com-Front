  "annotations": {
    "lean:irrational_sqrt_two": {
      "title": "Irrationality of √2",
      "summary": "The real square root of 2 would be rational only if 2 were a square of a rational number. A natural number that is a rational square is already a natural square, and the prime number 2 cannot be a natural square. Mathlib packages this argument as the theorem that the square root of every natural prime is irrational, then applies it to 2.",
      "areas": [
        "Number theory"
      ],
      "compact_latex": "\\sqrt{2}\\notin\\mathbb{Q}",
      "statement_latex": "\\neg\\exists q\\in\\mathbb{Q}:\\ (q:\\mathbb{R})=\\sqrt{2}",
      "why_here": "The final fact establishes this root theorem.",
      "support_edges": [
        18
      ],
      "provenance": {
        "kind": "supplied_response",
        "file": "argument.response.json",
        "author": "Source-reviewed explanations and ChatGPT proof roles",
        "prompt_version": 4
      }
    },
    "lean:Irrational": {
      "title": "Irrational real number",
      "summary": "The rational numbers sit inside the reals by coercion. A real number is irrational if no rational number has that real value. For a square root, a rational expression such as 3/2 would be a witness of rationality.",
      "areas": [
        "Number theory"
      ],
